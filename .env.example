PORT=4100

# Absolute paths to the installed toolchain binaries. Defaults assume
# noirup/bbup's standard install locations (~/.nargo/bin/nargo, ~/.bb/bb).
NARGO_BIN=
BB_BIN=

# Comma-separated API keys for POST /api/prove (sent as the X-API-Key header).
# Generate with: openssl rand -hex 32. Empty = /api/prove refuses everything.
PROVE_API_KEYS=

# Proof requests allowed per window, per client IP and per API key.
PROVE_RATE_WINDOW_MS=900000
PROVE_RATE_LIMIT_PER_IP=10
PROVE_RATE_LIMIT_PER_KEY=30

# Reverse-proxy hops in front of the server (1 behind Render/nginx), so per-IP
# limits see the real client IP. Leave 0 when exposed directly.
TRUST_PROXY_HOPS=0

# Kill a hung nargo/bb process after this long.
SUBPROCESS_TIMEOUT_MS=120000

# On SIGTERM, how long in-flight proofs get to finish before forced exit.
SHUTDOWN_TIMEOUT_MS=60000

# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Proofs allowed to run at once (each bb prove is CPU/memory heavy).
MAX_CONCURRENT_PROOFS=2

# Allowlist trees kept in memory for repeat proofs against the same list.
TREE_CACHE_SIZE=100
